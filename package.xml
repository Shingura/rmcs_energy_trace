<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmcs_energy_trace</name>
  <version>0.0.0</version>
  <description>Energy unit 6D pose estimation for the RMCS engineer robot.</description>
  <maintainer email="88925036+Shingura@users.noreply.github.com">shinzo</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>rmcs_executor</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>libpcl-all-dev</depend>
  <!-- OpenVINO 没有 rosdep 键，由 RMCS 的 Dockerfile 安装 -->
  <!-- 抓取仿真 grasp_sim 是可选的开发工具，MoveIt、RViz 等依赖不在这里声明；缺少时 CMake 跳过该目标 -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
